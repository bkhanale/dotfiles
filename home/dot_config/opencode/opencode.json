{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "share": "manual",
  "update": "auto",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    ".cursor/rules/*.md"
  ],
  "agents": {
    "plan": {
      "description": "Read-only architect that produces implementation plans without modifying files",
      "model": "anthropic/claude-sonnet-4-5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "review": {
      "description": "Read-only code reviewer for the current branch",
      "model": "anthropic/claude-sonnet-4-5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "title": {
      "model": "anthropic/claude-haiku-4-5"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
